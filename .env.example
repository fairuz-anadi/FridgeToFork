APP_NAME="FridgeToFork"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
CLIENT_PORT=5173

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Zero-setup local default. `php artisan migrate` creates database/database.sqlite.
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

# PostgreSQL — the deployment target (docker compose / Railway).
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=fridgetofork
# DB_USERNAME=fridgetofork
# DB_PASSWORD=StrongPassword123!

# SQL Server (legacy)
# DB_CONNECTION=sqlsrv
# DB_HOST=mssql
# DB_PORT=1433
# DB_DATABASE=fridgetofork
# DB_USERNAME=sa
# DB_PASSWORD=StrongPassword123!
# DB_ENCRYPT=no
# DB_TRUST_SERVER_CERTIFICATE=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs so local dev needs no SMTP server.
# Docker compose overrides this to `smtp` + mailpit.
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@fridgetofork.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_UI_PORT=8025
# Production: MAIL_MAILER=brevo with BREVO_API_KEY (Render blocks SMTP).
BREVO_API_KEY=
# Where Contact Admin complaints are emailed (defaults to ADMIN_EMAIL).
CONTACT_EMAIL=

ADMIN_EMAIL=admin@fridgetofork.local
ADMIN_PASSWORD=AdminPass123!

GOOGLE_CLIENT_ID=587227212522-eigpdur7u4l6vo5j9ltd0dnqe18m0qqn.apps.googleusercontent.com

# Third-party nutrition providers (optional). With both blank the app falls back
# to its built-in per-ingredient nutrition table, so nutrition insights still work.
NUTRITION_PROVIDER=local
SPOONACULAR_KEY=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# VITE_BACKEND_URL=http://localhost:8000
# VITE_FRONTEND_URL=http://localhost:5173
# VITE_MAILPIT_URL=http://localhost:8025